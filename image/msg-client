#!/usr/bin/env python3
"""Message client for task 4.

    msg-client tcp     connect to srv:9000, wait 0.5 s, then print every recv() result
    msg-client udp     send one datagram to srv:9000, print every recvfrom() result for 2 s
"""
import socket
import sys
import time

HOST, PORT = "10.53.0.80", 9000

mode = sys.argv[1] if len(sys.argv) > 1 else ""
if mode == "tcp":
    s = socket.create_connection((HOST, PORT), timeout=5)
    print(f"connected from port {s.getsockname()[1]}; waiting 0.5 s before reading")
    time.sleep(0.5)
    n = 0
    while True:
        data = s.recv(4096)
        if not data:
            break
        n += 1
        print(f"recv #{n}: {len(data)} bytes: {data.decode()}")
    print(f"connection closed by server; recv() calls with data: {n}")
elif mode == "udp":
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(2)
    s.sendto(b"hello", (HOST, PORT))
    print(f"sent 1 datagram from port {s.getsockname()[1]}; waiting 0.5 s before reading")
    time.sleep(0.5)
    n = 0
    try:
        while True:
            data, _ = s.recvfrom(4096)
            n += 1
            print(f"recvfrom #{n}: {len(data)} bytes: {data.decode()}")
    except socket.timeout:
        pass
    print(f"no more datagrams for 2 s; recvfrom() calls with data: {n}")
else:
    sys.exit(__doc__)
