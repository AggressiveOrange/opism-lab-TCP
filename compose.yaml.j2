    ipam:
      config:
        - subnet: 10.53.0.0/16

services:
  root:
    <<: *node
    command: ["auth"]
    volumes: ["./root:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.2 } }

  tld:
    <<: *node
    command: ["auth"]
    volumes: ["./tld:/lab:ro"]
    networks: { lab: { ipv4_address: 10.53.0.3 } }

  resolver-a:
    <<: *node
    command: ["resolver"]
    volumes: ["./resolver-a:/lab:ro"]
